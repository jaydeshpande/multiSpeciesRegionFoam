FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/permeate";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Cold permeate water enters at 293 K (20°C) from the y = 66 mm face (counter-flow).
// coupledTemperature at the membrane interface enforces thermal continuity.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293;

boundaryField
{
    permeate_inlet
    {
        type        fixedValue;
        value       uniform 293;    // T_perm = 20°C
    }

    permeate_outlet
    {
        type        zeroGradient;
    }

    permeate_outer
    {
        type        zeroGradient;   // adiabatic outer wall
    }

    permeate_to_membrane
    {
        type        coupledTemperature;
        value       uniform 293;
    }

    sides
    {
        type        empty;
    }
}

