FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Permeate channel: cold fresh water at 293 K, plug flow at 0.169 m/s in −y.
// Counter-flow configuration: inlet at y = 66 mm, outlet at y = 0.

ddtSchemes
{
    default     Euler;
}

gradSchemes
{
    default     Gauss linear;
}

divSchemes
{
    default             none;
    div(rhoPhi,e)       Gauss linearUpwind grad(e);
    div(phi,C_H2O)      Gauss upwind;
}

laplacianSchemes
{
    default     Gauss linear corrected;
}

interpolationSchemes
{
    default     linear;
}

snGradSchemes
{
    default     corrected;
}

